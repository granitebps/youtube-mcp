# No API key required by default: video info, comments, and search use youtubei.js (unofficial/internal InnerTube interface),
# transcripts always use youtube-transcript-plus (unofficial), regardless of YT_PROVIDER.

# Optional: serve video info, comments, and search through the official YouTube Data API v3.
# Bring your own YOUTUBE_API_KEY; the project does not provide a shared key.
# Useful on a VPS, where YouTube often blocks InnerTube requests from datacenter IPs.
# Transcripts do not use the official Data API or your key with either provider.
# YT_PROVIDER=api
# YOUTUBE_API_KEY=your-youtube-data-api-key

# The following are optional configuration for HTTP/VPS deployment:
# TRANSPORT=http
# PORT=3000
# HOST=0.0.0.0

# Optional: Set a secret token to protect your HTTP endpoint.
# If set, all requests must include: Authorization: Bearer <your-token>
# Leave unset for local development (no auth required).
# API_TOKEN=your-secret-token-here

# Optional: operational limits (defaults shown). Invalid values stop the server at startup.
# YT_INIT_TIMEOUT_MS=15000
# YT_REQUEST_TIMEOUT_MS=20000
# YT_TRANSCRIPT_MAX_BYTES=5000000
# YT_TRANSCRIPT_MAX_SEGMENTS=50000
# YT_TRANSCRIPT_PAGE_MAX_SEGMENTS=500
